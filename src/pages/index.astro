---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const writings = await getCollection("writings", ({ data }) => {
  return data.draft !== true;
});
---

<Layout title="akashmohan | typescript & vue engineer">
  <div class="min-h-screen bg-gruvbox-bg0 p-8">
    <div class="max-w-3xl mx-auto font-mono space-y-8">
      <h1 class="text-lg text-gruvbox-fg0">hey there!</h1>

      <p class="mt-2 text-lg text-gruvbox-fg1">
        akash here, i am a typescript engineer, currently bulding stuff <a
          href="https://x.com/realfastai"
          target="_blank"
          class="text-gruvbox-yellow hover:underline">@realfastai</a
        >
      </p>

      <div class="space-y-3">
        <p class="text-lg text-gruvbox-fg1">
          planning to do long form writings of my explorations . here's the
          first one.
        </p>
        {
          writings.map((post, index) => (
            <div>
              <span class="text-lg text-gruvbox-fg1">{index + 1}. </span>
              <a
                href={`/writings/${post.slug}`}
                class="text-lg text-gruvbox-green hover:underline transition-colors"
              >
                {post.data.title}
              </a>
            </div>
          ))
        }
      </div>

      <div class="">
        <p class="text-lg text-gruvbox-fg1 leading-relaxed tracking-wide">
          Here are my socials, say hi,
        </p>

        <a
          class="block text-lg text-gruvbox-fg0 hover:text-gruvbox-yellow transition-colors"
          target="_blank"
          href="https://twitter.com/buriedstupidity">twitter</a
        >
        <a
          class="block text-lg text-gruvbox-fg0 hover:text-gruvbox-yellow transition-colors"
          target="_blank"
          href="https://linkedin.com/in/amkdev">linkedin</a
        >
        <a
          class="block text-lg text-gruvbox-fg0 hover:text-gruvbox-yellow transition-colors"
          target="_blank"
          href="https://instagram.com/alterakash_">instagram</a
        >
        <a
          class="block text-lg text-gruvbox-fg0 hover:text-gruvbox-yellow transition-colors"
          target="_blank"
          href="https://github.com/amk-dev">github</a
        >

        <p class="text-lg text-gruvbox-fg1 leading-relaxed tracking-wide pt-4">
          follow me on twitter to see what i'm building and my hot takes.
        </p>
      </div>
    </div>
  </div>
</Layout>
